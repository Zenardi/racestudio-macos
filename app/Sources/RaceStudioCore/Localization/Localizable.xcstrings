          "stringUnit": {
            "state": "translated",
            "value": "This video has no audio track to match."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este vídeo não tem trilha de áudio para comparar."
          }
        }
      }
    },
    "video.autoSync.noMatch": {
      "comment": "Auto-sync from engine sound (issue 9.8): result headline when no alignment stands out clearly enough to offer.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No confident match"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma correspondência confiável"
          }
        }
      }
    },
    "video.autoSync.noMatchDetail": {
      "comment": "Auto-sync from engine sound (issue 9.8): what to do after a weak result.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine sound does not line up with the RPM clearly enough to trust. Align on a lap start instead."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som do motor não se alinha ao RPM com clareza suficiente. Alinhe pelo início de uma volta."
          }
        }
      }
    },
    "video.autoSync.noRPM": {
      "comment": "Auto-sync from engine sound (issue 9.8): the session has no usable RPM channel.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session has no RPM channel to match the engine sound against."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sessão não tem canal de RPM para comparar com o som do motor."
          }
        }
      }
    },
    "video.autoSync.noVideo": {
      "comment": "Auto-sync from engine sound (issue 9.8): help text when no video is attached.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach a video first."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe um vídeo primeiro."
          }
        }
      }
    },
    "video.autoSync.reading": {
      "comment": "Auto-sync from engine sound (issue 9.8): progress while the video's audio is decoded. %1$@ = percentage done, e.g. 42%.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading the video's audio… %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lendo o áudio do vídeo… %1$@"
          }
        }
      }
    },
    "video.autoSync.silent": {
      "comment": "Auto-sync from engine sound (issue 9.8): failure when no engine pitch is heard in the video's audio (silence, or only wind or music).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No engine sound was found in the video's audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum som de motor foi encontrado no áudio do vídeo."
          }
        }
      }
    },
    "video.autoSync.tooShort": {
      "comment": "Auto-sync from engine sound (issue 9.8): failure when the video and the session overlap too little.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video and the session overlap by less than 20 seconds."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vídeo e a sessão se sobrepõem por menos de 20 segundos."
          }
        }
      }
    },
    "video.autoSync.unreadable": {
      "comment": "Auto-sync from engine sound (issue 9.8): failure decoding the video's audio track.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video's audio could not be read."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o áudio do vídeo."
          }
        }
      }
    },
    "video.autoSync.unsupported": {
      "comment": "Auto-sync from engine sound (issue 9.8): this build has no analysis core to estimate with.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Engine-sound sync is not available in this build."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização pelo som do motor não está disponível nesta versão."
          }
        }
      }
    },
    "video.coverage.none": {
      "comment": "Video Review status line: no lap is filmed in full.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "footage covers no laps"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o vídeo não cobre nenhuma volta"
          }
        }
      }
    },
    "video.coverage.range": {
      "comment": "Video Review status line: %1$@ = first lap, %2$@ = last lap filmed in full, %3$@ = laps covered, %4$@ = total laps.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "footage covers laps %1$@–%2$@ (%3$@ of %4$@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o vídeo cobre as voltas %1$@–%2$@ (%3$@ de %4$@)"
          }
        }
      }
    },
    "video.coverage.single": {
      "comment": "Video Review status line: one lap filmed in full. %1$@ = lap number, %2$@ = laps covered, %3$@ = total laps.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "footage covers lap %1$@ (%2$@ of %3$@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o vídeo cobre a volta %1$@ (%2$@ de %3$@)"
          }
        }
      }
    },
    "video.help.anchorToSection": {
      "comment": "Video Review tooltip for Sync to Section.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Align the footage so the section under review starts on the frame on screen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinha o vídeo para que o trecho em análise comece no quadro exibido"
          }
        }
      }
    },
    "video.help.autoSync": {
      "comment": "Auto-sync from engine sound (issue 9.8): button help text when it can run.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate the offset by matching the engine sound against the RPM channel. You confirm the result before it is applied."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estima o deslocamento comparando o som do motor com o canal de RPM. Você confirma o resultado antes de aplicá-lo."
          }
        }
      }
    },
    "video.help.setAnchor": {
      "comment": "Video Review tooltip for Set Anchor A/B before the anchor is set.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrub to the frame where the selected lap starts, then set this anchor"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posicione o vídeo no quadro em que a volta selecionada começa e defina esta âncora"
          }
        }
      }
    },
    "video.help.twoPointSync": {
      "comment": "Video Review tooltip for Two-Point Sync once both anchors are set.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve the offset and clock rate so both anchors land on their frames"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula o deslocamento e a taxa do relógio para que as duas âncoras caiam em seus quadros"
          }
        }
      }
    },
    "video.help.workspaceButton": {
      "comment": "Tooltip of the workspace bar's Video + Data button.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch the session video with its data — HUD, lap plot and track map"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assista ao vídeo da sessão com os dados — HUD, gráfico da volta e mapa da pista"
          }
        }
      }
    },
    "video.lapLabel": {
      "comment": "A lap named in the Video + Data plot legend and lap grid. %1$@ = the 1-based lap number.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lap %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta %1$@"
          }
        }
      }
    },
    "video.loadingTelemetry": {
      "comment": "Video + Data placeholder while the session's telemetry loads.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading telemetry…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregando telemetria…"
          }
        }
      }
    },
    "video.message.anchorsTooClose": {
      "comment": "Video Review: the two sync anchors are too close together in session time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anchors A and B must be at least 10 s apart — set them on laps further apart."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As âncoras A e B precisam estar a pelo menos 10 s uma da outra — use voltas mais distantes."
          }
        }
      }
    },
    "video.message.implausibleDate": {
      "comment": "Video Review: the video file's creation date puts the footage outside the session, so no alignment was proposed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video’s date doesn’t match this session — align it on a lap start"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data do vídeo não corresponde a esta sessão — alinhe-o no início de uma volta"
          }
        }
      }
    },
    "video.message.missingAnchor": {
      "comment": "Video Review: two-point sync was requested before both anchors were set.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set anchor A and anchor B on two lap starts first."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina antes as âncoras A e B no início de duas voltas."
          }
        }
      }
    },
    "video.message.nonFinite": {
      "comment": "Video Review: an anchor holds an invalid time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Those anchors are not valid times — set them again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas âncoras não são tempos válidos — defina-as novamente."
          }
        }
      }
    },
    "video.message.rateOutOfBounds": {
      "comment": "Video Review: the two anchors imply an impossible camera clock rate. %1$@ = signed percentage, e.g. +1.00.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These anchors imply a %1$@%% clock difference — more than any camera drifts, so one is on the wrong frame or lap. The previous sync is kept."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas âncoras indicam uma diferença de relógio de %1$@%% — mais do que qualquer câmera desvia, então uma delas está no quadro ou na volta errada. A sincronização anterior foi mantida."
          }
        }
      }
    },
    "video.noFootage": {
      "comment": "Plate over the player when the attached video does not cover the cursor's moment.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No footage here"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem vídeo neste trecho"
          }
        }
      }
    },
