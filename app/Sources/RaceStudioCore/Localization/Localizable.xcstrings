    "video.anchor.setOnLap": {
      "comment": "Video Review: spoken value of a Set Anchor button once its anchor is set. %1$@ = lap number (1-based).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "set on lap %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "definida na volta %1$@"
          }
        }
      }
    },
    "video.coverage.none": {
      "comment": "Video Review status line: no lap is filmed in full.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "footage covers no laps"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o vídeo não cobre nenhuma volta"
          }
        }
      }
    },
    "video.coverage.range": {
      "comment": "Video Review status line: %1$@ = first lap, %2$@ = last lap filmed in full, %3$@ = laps covered, %4$@ = total laps.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "footage covers laps %1$@–%2$@ (%3$@ of %4$@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o vídeo cobre as voltas %1$@–%2$@ (%3$@ de %4$@)"
          }
        }
      }
    },
    "video.coverage.single": {
      "comment": "Video Review status line: one lap filmed in full. %1$@ = lap number, %2$@ = laps covered, %3$@ = total laps.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "footage covers lap %1$@ (%2$@ of %3$@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o vídeo cobre a volta %1$@ (%2$@ de %3$@)"
          }
        }
      }
    },
    "video.message.anchorsTooClose": {
      "comment": "Video Review: the two sync anchors are too close together in session time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anchors A and B must be at least 10 s apart — set them on laps further apart."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As âncoras A e B precisam estar a pelo menos 10 s uma da outra — use voltas mais distantes."
          }
        }
      }
    },
    "video.message.implausibleDate": {
      "comment": "Video Review: the video file's creation date puts the footage outside the session, so no alignment was proposed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video’s date doesn’t match this session — align it on a lap start"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data do vídeo não corresponde a esta sessão — alinhe-o no início de uma volta"
          }
        }
      }
    },
    "video.message.missingAnchor": {
      "comment": "Video Review: two-point sync was requested before both anchors were set.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set anchor A and anchor B on two lap starts first."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina antes as âncoras A e B no início de duas voltas."
          }
        }
      }
    },
    "video.message.nonFinite": {
      "comment": "Video Review: an anchor holds an invalid time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Those anchors are not valid times — set them again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas âncoras não são tempos válidos — defina-as novamente."
          }
        }
      }
    },
    "video.message.rateOutOfBounds": {
      "comment": "Video Review: the two anchors imply an impossible camera clock rate. %1$@ = signed percentage, e.g. +1.00.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These anchors imply a %1$@%% clock difference — more than any camera drifts, so one is on the wrong frame or lap. The previous sync is kept."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas âncoras indicam uma diferença de relógio de %1$@%% — mais do que qualquer câmera desvia, então uma delas está no quadro ou na volta errada. A sincronização anterior foi mantida."
          }
        }
      }
    },
    "video.status.anchored": {
      "comment": "Video Review status line: aligned on one lap start. %1$@ = lap number (1-based).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synced on lap %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizado na volta %1$@"
          }
        }
      }
    },
    "video.status.estimated": {
      "comment": "Video Review status line: the alignment was guessed from the video file's creation date.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated from file date"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado pela data do arquivo"
          }
        }
      }
    },
    "video.status.manual": {
      "comment": "Video Review status line: aligned by trimming the offset by hand, not on a lap.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synced by hand"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizado manualmente"
          }
        }
      }
    },
