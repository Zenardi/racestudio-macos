{
  "sourceLanguage": "en",
  "strings": {
    "accessibility.channel.label": {
      "comment": "VoiceOver label naming the plotted channel. %1$@ = channel name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channel %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Canal %1$@"
          }
        }
      }
    },
    "accessibility.channel.noData": {
      "comment": "VoiceOver value when a channel has no finite samples. %1$@ = channel name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, no data"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, sem dados"
          }
        }
      }
    },
    "accessibility.channel.summary": {
      "comment": "VoiceOver value summarizing a plotted channel. 1=name 2=unit 3=min 4=max.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, in %2$@, ranging from %3$@ to %4$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, em %2$@, variando de %3$@ a %4$@"
          }
        }
      }
    },
    "accessibility.channel.summary.noUnit": {
      "comment": "VoiceOver value for a dimensionless channel. 1=name 2=min 3=max.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ranging from %2$@ to %3$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, variando de %2$@ a %3$@"
          }
        }
      }
    },
