# Rust build output
/target/
core/**/target/

# Swift Package Manager build output
app/.build/

# UniFFI xcframework — a build artifact from scripts/build_xcframework.sh
# (~34 MB static lib). The generated Swift bindings in app/Generated/ ARE
# checked in; the xcframework is rebuilt on demand by the coverage gate.
app/*.xcframework/

# Test fixtures: large .xrk samples + reference CSV stay local (fetched by
# scripts/fetch_fixtures.sh); the small deterministic goldens in
# fixtures/golden/ ARE committed as the decode oracle.
fixtures/*.xrk
fixtures/*.csv
.venv-fixtures/

# Caches & build artifacts
.cache*
dist/

# Coverage output
*.profraw
*.profdata

# macOS
.DS_Store
__pycache__/

# Device reverse-engineering (M6) — forbidden AiM artifacts. Per ADR 0006 and
# docs/device/LEGAL_GATE.md we MUST NOT commit AiM firmware, RaceStudio DLLs, or
# the decompiled iOS app binary; only our own clean-room notes/fixtures of the
# on-the-wire bytes are kept. scripts/check_legal_gate.sh also rejects these in CI.
*.fw
*.dll
*.ipa
