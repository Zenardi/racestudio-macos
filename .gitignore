# Rust build output
/target/
core/**/target/

# Swift Package Manager build output
app/.build/

# UniFFI xcframework — a build artifact from scripts/build_xcframework.sh
# (~34 MB static lib). The generated Swift bindings in app/Generated/ ARE
# checked in; the xcframework is rebuilt on demand by the coverage gate.
app/*.xcframework/

# Test fixtures: large .xrk samples + reference CSV stay local (fetched by
# scripts/fetch_fixtures.sh); the small deterministic goldens in
# fixtures/golden/ ARE committed as the decode oracle.
fixtures/*.xrk
fixtures/*.csv
.venv-fixtures/

# Caches & build artifacts
.cache*
dist/

# Coverage output
*.profraw
*.profdata

# macOS
.DS_Store
